{
  "name": "control",
  "private": true,
  "version": "1.4.0",
  "description": "Control de Proyectos Estructurales",
  "author": "Antigravity",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:exe": "npm run build && electron-packager . \"Antigravity CONTROL\" --platform=win32 --arch=x64 --out=dist-electron --overwrite"
  },
  "build": {
    "appId": "com.antigravity.control",
    "productName": "Antigravity CONTROL",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "fileAssociations": [
        {
          "ext": "lch",
          "name": "LCH Project File",
          "description": "Archivo de Proyecto CONTROL",
          "role": "Editor",
          "icon": "build/lch_icon.ico"
        },
        {
          "ext": "lchp",
          "name": "LCH Photos File",
          "description": "Archivo de Fotos CONTROL",
          "role": "Editor",
          "icon": "build/lchp_icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Antigravity CONTROL"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "date-fns": "^4.1.0",
    "imapflow": "^1.3.5",
    "jszip": "^3.10.1",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.4.0",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "wait-on": "^9.0.5"
  }
}
